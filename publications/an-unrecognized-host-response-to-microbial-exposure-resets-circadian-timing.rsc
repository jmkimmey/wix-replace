0:{"__route":"route:/publications/an-unrecognized-host-response-to-microbial-exposure-resets-circadian-timing","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","__sourcePage":"/publications/[slug]/page","page:/publications/an-unrecognized-host-response-to-microbial-exposure-resets-circadian-timing":"$L1","layout:/":[[[["$","link","css:/_next/static/css/index.DLtcx9Bp.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/index.DLtcx9Bp.css","data-rsc-css-href":"/_next/static/css/index.DLtcx9Bp.css"}],"$undefined"],["$","html",null,{"lang":"en","children":["$","body",null,{"children":["$","$L2",null,{}]}]}]],null],"route:/publications/an-unrecognized-host-response-to-microbial-exposure-resets-circadian-timing":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"An unrecognized host response to microbial exposure resets circadian timing | Kimmey Lab"}],["$","meta","1",{"name":"description","content":"As ubiquitous features of every natural environment, microbes have profoundly shaped eukaryotic biology throughout evolution. Circadian clocks evolved in all domains of life as central regulators that align physiology with environmental cycles, yet whether they respond directly to microbial signals remains unknown. Here, we demonstrate that evolutionarily diverse microbes potently reset mammalian cellular clocks and can drive phase shifts in plants and algae, indicating cross-kingdom effects of microbes on circadian rhythms. In mammals, exposure to soluble bacterial components distinct from canonical innate immune ligands induces acute PER2 upregulation independently of Bmal1 or nascent transcription. A targeted inhibitor screen and biochemical assays implicate p38 MAPK as a modulator of this response. Taken together, this positions bacterial exposure as a previously unrecognized circadian clock input, revealing a new axis of host-microbe interaction that modulates biological timing at the cellular level."}],["$","meta","2",{"property":"og:title","content":"Kimmey Lab | UC Santa Cruz"}],["$","meta","3",{"property":"og:description","content":"Circadian rhythms, innate immunity, and bacterial infection at UC Santa Cruz."}],["$","meta","4",{"property":"og:image","content":"https://kimmeylab.com/og.png"}],["$","meta","5",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","6",{"name":"twitter:title","content":"Kimmey Lab | UC Santa Cruz"}],["$","meta","7",{"name":"twitter:description","content":"Circadian rhythms, innate immunity, and bacterial infection at UC Santa Cruz."}],["$","meta","8",{"name":"twitter:image","content":"https://kimmeylab.com/og.png"}],["$","link","9",{"rel":"shortcut icon","href":"/assets/kimmeylab/logo/LOGO only.png"}],["$","link","10",{"rel":"icon","href":"/assets/kimmeylab/logo/LOGO only.png"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L3",null,{"fallback":"$4","children":["$","$L5",null,{"fallback":"$4","children":["$","$L6",null,{"providerId":"layout:/","segmentMap":{"children":["publications","an-unrecognized-host-response-to-microbial-exposure-resets-circadian-timing"]},"children":["$","$L7",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L8",null,{"children":["$","$L9",null,{"children":[["$","$L6",null,{"providerId":"page:/publications/an-unrecognized-host-response-to-microbial-exposure-resets-circadian-timing","segmentMap":{"children":["__PAGE__"]},"children":["$","$L7",null,{"id":"page:/publications/an-unrecognized-host-response-to-microbial-exposure-resets-circadian-timing"}]}],null]}]}]}]}]}]}],null,null],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:ece8136015c1c92c","deploymentVersion":"ef30095f-9a7b-43ae-8a1a-dda2d8e64977","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null},"__renderObservation":{"schemaVersion":1,"outp