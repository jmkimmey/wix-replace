1:["$","main",null,{"children":[["$","header",null,{"className":"site-nav","aria-label":"Primary navigation","children":[["$","a",null,{"className":"brand","href":"/","children":[["$","img",null,{"src":"/assets/kimmeylab/logo/LOGO_Breath Wave -teal.png","alt":""}],["$","span",null,{"children":"Kimmey Lab"}]]}],["$","nav",null,{"children":[["$","a",null,{"href":"/#research","children":"Research"}],["$","a",null,{"href":"/people","children":"People"}],["$","a",null,{"href":"/publications","children":"Publications"}],["$","a",null,{"href":"/join","children":"Join"}],["$","a",null,{"href":"/diversity","children":"Diversity"}],["$","a",null,{"href":"/contact","children":"Contact"}]]}]]}],["$","section",null,{"className":"page-hero","children":[["$","p",null,{"className":"eyebrow dark","children":"Join"}],["$","h1",null,{"children":"Joining the Lab"}],["$","p",null,{"children":["Make sure to check out our ",["$","a",null,{"href":"/#research","children":"research page"}]," to see what it is like to be in the lab. Think you might be a good fit? Join us."]}]]}],["$","section",null,{"className":"section content-page","children":[["$","article",null,{"className":"text-card","children":[["$","h2",null,{"children":"Postdoctoral Fellows"}],["$","p",null,{"children":["Interested applicants should contact Dr. Kimmey and include a cover letter that includes a description of your research experience and the research you want to carry out in the lab, and your CV. Postdoctoral fellows must have done their PhD in a microbiology or molecular biology related field. Experience with hypothesis-driven research in microbiology, pathogenesis, immunology, circadian biology or cell biology is required. Our lab is ",["$","em",null,{"children":"not a good fit"}]," ","for applicants interested in metagenomics, clinical surveillance/epidemiology, antibiotic screening etc."]}],["$","p",null,{"className":"note","children":"Prospective postdoctoral candidates should review the lab's recent papers and explain which specific research directions they are interested in pursuing in the Kimmey Lab. Strong inquiries connect the candidate's prior experience to concrete questions, approaches, or open problems raised by recent lab publications."}]]}],["$","article",null,{"className":"text-card","children":[["$","h2",null,{"children":"Graduate Students"}],["$","p",null,{"children":["We accept Ph.D. students via the Program in Biomedical Sciences and Engineering (PBSE) via the"," ",["$","a",null,{"href":"https://microbiology.ucsc.edu/graduate/index.html","children":"Microbial Biology and Pathogenesis (MICRO)"}]," ","track."]}],["$","p",null,{"className":"note","children":"Students interested in applying should check current PBSE admissions instructions and deadlines."}]]}],["$","article",null,{"className":"text-card","children":[["$","h2",null,{"children":"Undergraduate Researchers"}],["$","p",null,{"children":["We accept committed undergraduate researchers to carry out independent study as space allows. Students must be able to commit 15 hours/week for at least 4 quarters. Interested undergraduate students should fill out"," ",["$","a",null,{"href":"https://forms.gle/cBP6LbBBihakZPUk9","children":"this form"}],". We review responses when space and mentorship capacity become available. Openings depend on current projects, senior lab member availability, and when current undergraduate researchers graduate. If you have submitted the form, you do not need to email or check in."]}],["$","p",null,{"children":"Students interested in the lab are encouraged to take METX 100 as soon as it fits their undergraduate plan. It is not required to join the lab, but the course covers microbiology concepts that are highly relevant to our research. Students who engage deeply with course material and research discussions in METX 100 often get a stronger sense of whether the lab is a good fit."}],"$La","$Lb"]}]]}],"$Lc"]}]
