1:["$","main",null,{"children":[["$","header",null,{"className":"site-nav","aria-label":"Primary navigation","children":[["$","a",null,{"className":"brand","href":"/","children":[["$","img",null,{"src":"/assets/kimmeylab/logo/LOGO_Breath Wave -teal.png","alt":""}],["$","span",null,{"children":"Kimmey Lab"}]]}],["$","nav",null,{"children":[["$","a",null,{"href":"/#research","children":"Research"}],["$","a",null,{"href":"/people","children":"People"}],["$","a",null,{"href":"/publications","children":"Publications"}],["$","a",null,{"href":"/join","children":"Join"}],["$","a",null,{"href":"/diversity","children":"Diversity"}],["$","a",null,{"href":"/contact","children":"Contact"}]]}]]}],["$","article",null,{"className":"detail-layout person-detail","children":[["$","aside",null,{"children":[["$","img",null,{"src":"/assets/kimmeylab/team/Catherine Palmer.jpeg","alt":"Catherine Palmer"}],["$","a",null,{"className":"button button-secondary","href":"/people","children":"All people"}]]}],["$","div",null,{"className":"detail-main","children":[["$","p",null,{"className":"eyebrow dark","children":"Team member"}],["$","h1",null,{"children":"Catherine Palmer"}],["$","p",null,{"className":"detail-meta","children":"Ph.D. Candidate (Qualified!)"}],["$","p",null,{"className":"dates","children":"(03/2021 - present)"}],["$","p",null,{"children":"caspalme@ucsc.edu"}],["$","div",null,{"className":"highlight-list","children":[["$","p","Fun fact: I probably have sand in my shoes!",{"children":"Fun fact: I probably have sand in my shoes!"}],["$","p","Area of focus: time of day susceptibility to pneumonia, pulmonary immunity",{"children":"Area of focus: time of day susceptibility to pneumonia, pulmonary immunity"}],["$","p","Ask me to help with: murine models, pathogenesis, flow cytometry, S. pneumoniae",{"children":"Ask me to help with: murine models, pathogenesis, flow cytometry, S. pneumoniae"}]]}],["$","h2",null,{"children":"Bio"}],[["$","p","Catherine graduated from New York University Abu Dhabi in 2020 with a B. S. in Biology. She completed her undergraduate thesis in the Sadler Edepli Lab, where she studied fatty liver disease in zebrafish. Her research focused on how similar environmental conditions (both toxicological and microbiologic) can lead to differential disease outcomes. Her interests led her to pursue a PhD in the Microbiology and Environmental Toxicology program at University of California Santa Cruz where she joined the Kimmey Lab in 2021. Her research focuses on the regulation of innate effectors and pathogenesis.",{"children":"Catherine graduated from New York University Abu Dhabi in 2020 with a B. S. in Biology. She completed her undergraduate thesis in the Sadler Edepli Lab, where she studied fatty liver disease in zebrafish. Her research focused on how similar environmental conditions (both toxicological and microbiologic) can lead to differential disease outcomes. Her interests led her to pursue a PhD in the Microbiology and Environmental Toxicology program at University of California Santa Cruz where she joined the Kimmey Lab in 2021. Her research focuses on the regulation of innate effectors and pathogenesis."}],["$","p","Catherine successfully passed her PhD Qualifying Exam and advanced to candidace in Spring 2022. She is now a qualified PhD candidate :)",{"children":"Catherine successfully passed her PhD Qualifying Exam and advanced to candidace in Spring 2022. She is now a qualified PhD candidate :)"}]]]}]]}],["$","footer",null,{"className":"footer","id":"contact","children":[["$","img",null,{"src":"/assets/kimmeylab/logo/ucsc logo.png","alt":"UC Santa Cruz"}],["$","div",null,{"children":[["$","strong",null,{"children":"Kimmey Lab"}],["$","p",null,{"children":"Department of Microbiology and Environmental Toxicology"}],["$","p",null,{"children":"Biomedical Sciences, UC Santa Cruz"}]]}]]}]]}]
