1:["$","main",null,{"children":[["$","header",null,{"className":"site-nav","aria-label":"Primary navigation","children":[["$","a",null,{"className":"brand","href":"/","children":[["$","img",null,{"src":"/assets/kimmeylab/logo/LOGO_Breath Wave -teal.png","alt":""}],["$","span",null,{"children":"Kimmey Lab"}]]}],["$","nav",null,{"children":[["$","a",null,{"href":"/#research","children":"Research"}],["$","a",null,{"href":"/people","children":"People"}],["$","a",null,{"href":"/publications","children":"Publications"}],["$","a",null,{"href":"/join","children":"Join"}],["$","a",null,{"href":"/diversity","children":"Diversity"}],["$","a",null,{"href":"/contact","children":"Contact"}]]}]]}],["$","article",null,{"className":"detail-layout person-detail","children":[["$","aside",null,{"children":[["$","img",null,{"src":"/assets/kimmeylab/team/Camila Morales Fenero.jpeg","alt":"Camila Morales Fénero, PhD"}],["$","a",null,{"className":"button button-secondary","href":"/people","children":"All people"}]]}],["$","div",null,{"className":"detail-main","children":[["$","p",null,{"className":"eyebrow dark","children":"Team member"}],["$","h1",null,{"children":"Camila Morales Fénero, PhD"}],["$","p",null,{"className":"detail-meta","children":"Postdoctoral Fellow"}],["$","p",null,{"className":"dates","children":"(02/2023 - present)"}],["$","p",null,{"children":"cmoral44@ucsc.edu"}],["$","div",null,{"className":"highlight-list","children":[["$","p","Fun fact: I am a choir singer and love cats!",{"children":"Fun fact: I am a choir singer and love cats!"}],["$","p","Area of focus: zebrafish infection models and circadian rhythms",{"children":"Area of focus: zebrafish infection models and circadian rhythms"}],["$","p","Ask me to help with: anything zebrafish, histology, microscopy, molecular biology",{"children":"Ask me to help with: anything zebrafish, histology, microscopy, molecular biology"}]]}],["$","h2",null,{"children":"Bio"}],[["$","p","Camila graduated as a Medical Technologist at the University of Chile (UChile). She completed her undergraduate thesis in Colombo Lab where she studied the effects of the loss of function of the gene daam1 in the expression of asymmetries on the zebrafish habenula. She then moved to Brazil and pursued a Master’s and a Ph.D. in Immunology at the University of São Paulo (USP) in Saraiva Camara Lab where she studied the role of microbiota in the intestinal inflammation induced by TNBS and then by obesity with zebrafish as a model organism.",{"children":"Camila graduated as a Medical Technologist at the University of Chile (UChile). She completed her undergraduate thesis in Colombo Lab where she studied the effects of the loss of function of the gene daam1 in the expression of asymmetries on the zebrafish habenula. She then moved to Brazil and pursued a Master’s and a Ph.D. in Immunology at the University of São Paulo (USP) in Saraiva Camara Lab where she studied the role of microbiota in the intestinal inflammation induced by TNBS and then by obesity with zebrafish as a model organism."}],["$","p","After finishing her Ph.D. she did a one-year postdoc at Pacheco Lab in the Federal University of São Paulo (UNIFESP), working on microbiota-metabolites that affect the progression of acute kidney injury in an obese model in zebrafish. She joined the Kimmey Lab at UCSC in 2023, her research focuses on the interaction of infectious diseases with the immune system and their effect on circadian rhythms.",{"children":"After finishing her Ph.D. she did a one-year postdoc at Pacheco Lab in the Federal University of São Paulo (UNIFESP), working on microbiota-metabolites that affect the progression of acute kidney injury in an obese model in zebrafish. She joined the Kimmey Lab at UCSC in 2023, her research focuses on the interaction of infectious diseases with the immune system and their effect on circadian rhythms."}]]]}]]}],"$La"]}]
