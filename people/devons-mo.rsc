1:["$","main",null,{"children":[["$","header",null,{"className":"site-nav","aria-label":"Primary navigation","children":[["$","a",null,{"className":"brand","href":"/","children":[["$","img",null,{"src":"/assets/kimmeylab/logo/LOGO_Breath Wave -teal.png","alt":""}],["$","span",null,{"children":"Kimmey Lab"}]]}],["$","nav",null,{"children":[["$","a",null,{"href":"/#research","children":"Research"}],["$","a",null,{"href":"/people","children":"People"}],["$","a",null,{"href":"/publications","children":"Publications"}],["$","a",null,{"href":"/join","children":"Join"}],["$","a",null,{"href":"/diversity","children":"Diversity"}],["$","a",null,{"href":"/contact","children":"Contact"}]]}]]}],["$","article",null,{"className":"detail-layout person-detail","children":[["$","aside",null,{"children":[["$","img",null,{"src":"/assets/kimmeylab/team/Devons Mo.jpg","alt":"Devons Mo"}],["$","a",null,{"className":"button button-secondary","href":"/people","children":"All people"}]]}],["$","div",null,{"className":"detail-main","children":[["$","p",null,{"className":"eyebrow dark","children":"Team member"}],["$","h1",null,{"children":"Devons Mo"}],["$","p",null,{"className":"detail-meta","children":"Ph.D. Candidate (Qualified!)"}],["$","p",null,{"className":"dates","children":"(05/2023 - present)"}],["$","p",null,{"children":"dmo24@ucsc.edu"}],["$","div",null,{"className":"highlight-list","children":[["$","p","Fun Fact: My favorite animal is a tree frog",{"children":"Fun Fact: My favorite animal is a tree frog"}],["$","p","Area of focus: how microbes affect the mammalian circadian clock",{"children":"Area of focus: how microbes affect the mammalian circadian clock"}],["$","p","Ask me to help with: cell culture, circadian handling and data analysis, coding",{"children":"Ask me to help with: cell culture, circadian handling and data analysis, coding"}]]}],["$","h2",null,{"children":"Bio"}],[["$","p","Devons graduated from UCLA in 2020 with a B.S. in Biochemistry. During his undergraduate years, he was part of the Gober Lab, where he attempted to discover novel, man-made antibiotics that were effective against S. pneumoniae. After graduating from UCLA, he pursued a Master's degree at San Jose State University in Biological Sciences, with a concentration in Microbiology and Molecular Biology. There, he was part of the Adams Lab, where he studied the effects of the S. pneumoniae toxin, pneumolysin, on the intercellular junctions of lung epithelial cells. He graduated with a M.S. in 2022.",{"children":"Devons graduated from UCLA in 2020 with a B.S. in Biochemistry. During his undergraduate years, he was part of the Gober Lab, where he attempted to discover novel, man-made antibiotics that were effective against S. pneumoniae. After graduating from UCLA, he pursued a Master's degree at San Jose State University in Biological Sciences, with a concentration in Microbiology and Molecular Biology. There, he was part of the Adams Lab, where he studied the effects of the S. pneumoniae toxin, pneumolysin, on the intercellular junctions of lung epithelial cells. He graduated with a M.S. in 2022."}],["$","p","He joined the Kimmey Lab in 2023 to pursue a Ph.D. His research focuses on determining the how the circadian clock controls innate immune pathways. In his free time, he collects carnivorous plants. His current collection includes venus flytraps, sundews, and pitcher plants.",{"children":"He joined the Kimmey Lab in 2023 to pursue a Ph.D. His research focuses on determining the how the circadian clock controls innate immune pathways. In his free time, he collects carnivorous plants. His current collection includes venus flytraps, sundews, and pitcher plants."}],["$","p","Devons successfully passed his QE on June 7, 2024!!",{"children":"Devons successfully passed his QE on June 7, 2024!!"}]]]}]]}],"$La"]}]
