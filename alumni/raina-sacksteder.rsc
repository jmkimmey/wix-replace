1:["$","main",null,{"children":[["$","header",null,{"className":"site-nav","aria-label":"Primary navigation","children":[["$","a",null,{"className":"brand","href":"/","children":[["$","img",null,{"src":"/assets/kimmeylab/logo/LOGO_Breath Wave -teal.png","alt":""}],["$","span",null,{"children":"Kimmey Lab"}]]}],["$","nav",null,{"children":[["$","a",null,{"href":"/#research","children":"Research"}],["$","a",null,{"href":"/people","children":"People"}],["$","a",null,{"href":"/publications","children":"Publications"}],["$","a",null,{"href":"/join","children":"Join"}],["$","a",null,{"href":"/diversity","children":"Diversity"}],["$","a",null,{"href":"/contact","children":"Contact"}]]}]]}],["$","article",null,{"className":"detail-layout person-detail","children":[["$","aside",null,{"children":[["$","img",null,{"src":"/assets/kimmeylab/team/alumni/Raina Sacksteder.png","alt":"Raina Sacksteder"}],["$","a",null,{"className":"button button-secondary","href":"/people","children":"All people"}]]}],["$","div",null,{"className":"detail-main","children":[["$","p",null,{"className":"eyebrow dark","children":"Alumni"}],["$","h1",null,{"children":"Raina Sacksteder"}],["$","p",null,{"className":"detail-meta","children":"MS Student — degree awarded March 2023"}],["$","p",null,{"className":"dates","children":"03/2021-12/2022"}],["$","div",null,{"className":"highlight-list","children":[["$","p","Fun Fact: She runs the Etsy shop FrogsOnSwings!",{"children":"Fun Fact: She runs the Etsy shop FrogsOnSwings!"}],["$","p","Area of focus: mechanism of circadian clocks in zebrafish, impact of Spn exposure",{"children":"Area of focus: mechanism of circadian clocks in zebrafish, impact of Spn exposure"}],["$","p","Ask me to help with: zebrafish, Tol2 transgenesis, circadian clock",{"children":"Ask me to help with: zebrafish, Tol2 transgenesis, circadian clock"}]]}],["$","h2",null,{"children":"Bio"}],[["$","p","Raina graduated from Reed College in 2020 with a B.A. in Biology. She completed her undergraduate thesis in the Cerveny Lab, where she studied the gene targets of retinoic acid during retinal neurogenesis in the developing zebrafish eye. A summer position in the Ott Lab at UCSF sparked her passion for host-microbe interactions, which lead her to pursue a PhD in Microbial Biology and Pathogenesis at UCSC and join the Kimmey Lab in 2021. Her research uses zebrafish to understand how infection alters the circadian clock.",{"children":"Raina graduated from Reed College in 2020 with a B.A. in Biology. She completed her undergraduate thesis in the Cerveny Lab, where she studied the gene targets of retinoic acid during retinal neurogenesis in the developing zebrafish eye. A summer position in the Ott Lab at UCSF sparked her passion for host-microbe interactions, which lead her to pursue a PhD in Microbial Biology and Pathogenesis at UCSC and join the Kimmey Lab in 2021. Her research uses zebrafish to understand how infection alters the circadian clock."}]]]}]]}],["$","footer",null,{"className":"footer","id":"contact","children":[["$","img",null,{"src":"/assets/kimmeylab/logo/ucsc logo.png","alt":"UC Santa Cruz"}],["$","div",null,{"children":[["$","strong",null,{"children":"Kimmey Lab"}],["$","p",null,{"children":"Department of Microbiology and Environmental Toxicology"}],["$","p",null,{"children":"Biomedical Sciences, UC Santa Cruz"}]]}]]}]]}]
