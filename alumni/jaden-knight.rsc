1:["$","main",null,{"children":[["$","header",null,{"className":"site-nav","aria-label":"Primary navigation","children":[["$","a",null,{"className":"brand","href":"/","children":[["$","img",null,{"src":"/assets/kimmeylab/logo/LOGO_Breath Wave -teal.png","alt":""}],["$","span",null,{"children":"Kimmey Lab"}]]}],["$","nav",null,{"children":[["$","a",null,{"href":"/#research","children":"Research"}],["$","a",null,{"href":"/people","children":"People"}],["$","a",null,{"href":"/publications","children":"Publications"}],["$","a",null,{"href":"/join","children":"Join"}],["$","a",null,{"href":"/diversity","children":"Diversity"}],["$","a",null,{"href":"/contact","children":"Contact"}]]}]]}],["$","article",null,{"className":"detail-layout person-detail","children":[["$","aside",null,{"children":[["$","img",null,{"src":"/assets/kimmeylab/team/alumni/Jaden Knight.jpeg","alt":"Jaden Knight"}],["$","a",null,{"className":"button button-secondary","href":"/people","children":"All people"}]]}],["$","div",null,{"className":"detail-main","children":[["$","p",null,{"className":"eyebrow dark","children":"Alumni"}],["$","h1",null,{"children":"Jaden Knight"}],["$","p",null,{"className":"detail-meta","children":"MS Student — degree awarded March 2025"}],["$","p",null,{"className":"dates","children":"METX 4+1 (06/2022 - present)"}],["$","div",null,{"className":"highlight-list","children":[["$","p","Fun Fact: I worked on the UCSC Farm and know quantum chemistry!",{"children":"Fun Fact: I worked on the UCSC Farm and know quantum chemistry!"}],["$","p","Area of focus: chemical identification of clock modulating ligands",{"children":"Area of focus: chemical identification of clock modulating ligands"}],["$","p","Ask me to help with: bacterial fractionation, MS, HPLC, NMR",{"children":"Ask me to help with: bacterial fractionation, MS, HPLC, NMR"}]]}],["$","h2",null,{"children":"Bio"}],[["$","p","Jaden joined the lab in summer 2022 as an undergraduate researcher. He's been a Jack of All Trades - rapidly immersing himself in all areas of our lab's research ranging across our animal models to cell culture to full our chemistry! Jaden was admitted to the 4+1 Masters program in Fall 2022 followed by formal admission to the graduate program. Jaden formally started as a full time graduate student upon conferral of his B.S. in June 2023.",{"children":"Jaden joined the lab in summer 2022 as an undergraduate researcher. He's been a Jack of All Trades - rapidly immersing himself in all areas of our lab's research ranging across our animal models to cell culture to full our chemistry! Jaden was admitted to the 4+1 Masters program in Fall 2022 followed by formal admission to the graduate program. Jaden formally started as a full time graduate student upon conferral of his B.S. in June 2023."}],["$","p","Jaden successfully completed his Masters Qualifying Examination in Dec. 2023! He is now a qualified candidate :)",{"children":"Jaden successfully completed his Masters Qualifying Examination in Dec. 2023! He is now a qualified candidate :)"}]]]}]]}],["$","footer",null,{"className":"footer","id":"contact","children":[["$","img",null,{"src":"/assets/kimmeylab/logo/ucsc logo.png","alt":"UC Santa Cruz"}],["$","div",null,{"children":[["$","strong",null,{"children":"Kimmey Lab"}],["$","p",null,{"children":"Department of Microbiology and Environmental Toxicology"}],["$","p",null,{"children":"Biomedical Sciences, UC Santa Cruz"}]]}]]}]]}]
